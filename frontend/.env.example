# ProdWatch Frontend — Environment Variables
# =============================================================================
# Java API (local or deployed on Render)
# =============================================================================
# Base path including /api/v1 — no trailing slash.
VITE_API_BASE_URL=http://localhost:8080/api/v1

# Copy from backend/.env; anon key is safe to expose in the browser.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
