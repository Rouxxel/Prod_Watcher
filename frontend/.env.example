# ProdWatch Frontend — Environment Variables
# =============================================================================
# Java API (local or deployed on Render)
# =============================================================================
# Base path including /api/v1 — no trailing slash.
VITE_API_BASE_URL=http://localhost:8080/api/v1

# =============================================================================
# Deployment (Vercel / Cloudflare Workers)
# =============================================================================
# Set VITE_API_BASE_URL in your host dashboard to the deployed Render API URL.
# Configure Supabase Auth redirect URLs and backend CORS on the server side only.
