{
    "defaults": {
        "general_data_path": "core_specs/data/general_data.json"
    },

    "logging": {
        "logging_level": "debug",
        "dir_name": "logs",
        "log_file_name": "prodwatch_api"
    },

    "email_validation": {
        "allowed_providers": ["gmail", "outlook", "yahoo", "hotmail", "icloud", "protonmail", "aol", "zoho", "gmx", "mail"],
        "allowed_tlds": ["com", "org", "net", "co", "io", "edu", "gov"]
    },

    "network": {
        "server_port": 8080,
        "host": "0.0.0.0",
        "context_path": ""
    },

    "endpoints": {
        "root_directory_endpoint": {
            "request_limit": 25,
            "unit_of_time_for_limit": "m",
            "endpoint_prefix": "",
            "endpoint_tag": "root",
            "endpoint_route": "/"
        },

        "health_endpoint": {
            "request_limit": 30,
            "unit_of_time_for_limit": "m",
            "endpoint_prefix": "/api/v1",
            "endpoint_tag": "health",
            "endpoint_route": "/health"
        },

        "auth_endpoint": {
            "request_limit": 20,
            "unit_of_time_for_limit": "m",
            "endpoint_prefix": "/api/v1",
            "endpoint_tag": "auth",
            "endpoint_route": "/auth"
        },

        "products_endpoint": {
            "request_limit": 60,
            "unit_of_time_for_limit": "m",
            "endpoint_prefix": "/api/v1",
            "endpoint_tag": "products",
            "endpoint_route": "/products"
        },

        "warehouses_endpoint": {
            "request_limit": 30,
            "unit_of_time_for_limit": "m",
            "endpoint_prefix": "/api/v1",
            "endpoint_tag": "warehouses",
            "endpoint_route": "/warehouses"
        },

        "movements_endpoint": {
            "request_limit": 40,
            "unit_of_time_for_limit": "m",
            "endpoint_prefix": "/api/v1",
            "endpoint_tag": "stock-movements",
            "endpoint_route": "/stock-movements"
        },

        "audit_endpoint": {
            "request_limit": 30,
            "unit_of_time_for_limit": "m",
            "endpoint_prefix": "/api/v1",
            "endpoint_tag": "audit",
            "endpoint_route": "/audit"
        },

        "users_endpoint": {
            "request_limit": 20,
            "unit_of_time_for_limit": "m",
            "endpoint_prefix": "/api/v1",
            "endpoint_tag": "users",
            "endpoint_route": "/users"
        },

        "transactions_endpoint": {
            "request_limit": 30,
            "unit_of_time_for_limit": "m",
            "endpoint_prefix": "/api/v1",
            "endpoint_tag": "transactions",
            "endpoint_route": "/transactions"
        },

        "settings_endpoint": {
            "request_limit": 30,
            "unit_of_time_for_limit": "m",
            "endpoint_prefix": "/api/v1",
            "endpoint_tag": "settings",
            "endpoint_route": "/settings"
        }
    },

    "redis_cache": {
        "ttl_seconds": {
            "profile": 600,
            "settings": 1800,
            "warehouses_list": 3600,
            "warehouse": 3600,
            "product_meta": 1800,
            "ecosystem": 21600,
            "movement": 86400,
            "audit": 86400,
            "transaction": 86400,
            "stock_display": 15
        }
    }
}
