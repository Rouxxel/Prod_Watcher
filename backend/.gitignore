#############################################################################
### .gitignore for a Gradle / Spring Boot Java project
#############################################################################

# --- Build output ---
build/
out/
bin/
target/
*.class
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar
!gradle/wrapper/gradle-wrapper.jar   # keep the wrapper jar if you commit it

# --- Gradle ---
.gradle/
gradle-app.setting
!gradle-wrapper.properties

# --- Logs ---
logs/
log/
*.log

# --- Environment / secrets ---
.env
.env.local
.env.development
.env.production
*.pem

# --- IDEs / editors ---
.idea/
*.iml
*.ipr
*.iws
.vscode/
.settings/
.project
.classpath
.factorypath
*.swp
*.swo
*~

# --- OS ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# --- Misc / local scratch ---
*.tmp
*.temp
Example.java
Tester.java

# --- Deployment scratch files ---
ecs-task-definition-final.json
trust-policy.json
apprunner-service.json

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*