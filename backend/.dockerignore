# ProdWatch API — Docker build context exclusions

# Build output (rebuilt inside the image)
build/
out/
bin/
.gradle/

# Legacy wrapper path (use gradle/wrapper/ only)
wrapper/

# Logs (created in the container)
logs/
*.log

# Env files (passed via env_file / real environment, not baked into the image)
.env
.env.local
.env.production
.env.development

# Keys must never be copied into the image
*.pem

# IDE / editor
.idea/
.vscode/
*.iml
*.swp
*.swo
*~

# Git
.git/
.gitignore
.gitattributes

# Docs / tests not needed at runtime
README.md
*.md
src/test/

# OS files
.DS_Store
Thumbs.db
