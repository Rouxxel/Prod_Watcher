# Java REST API Template - Environment Variables
# Copy this file to .env and fill in real values for local development.
#
# NOTE: The bound port/host come from
#   src/main/resources/core_specs/configuration/config_file.json
# (network.server_port / network.host). SERVER_PORT below is only used by
# docker-compose to publish the container port.

# --- Docker / server ---
SERVER_PORT=8080

# --- API metadata (read by application.properties) ---
API_TITLE=Java REST API Template
API_VERSION=1.0.0
API_DESCRIPTION=A template for building REST APIs with Spring Boot

# --- RSA encryption keys (required only if you use util/EnDeCrypt) ---
# Generate once with util/KeysGenerator, then paste the PEM contents here.
# Newlines may be encoded as literal \n on a single line.
E_PUBLIC_KEY=your_public_key_pem_here
E_PRIVATE_KEY=your_private_key_pem_here
E_PRIVATE_PASSWORD=optional_unused_with_bundled_keygen

# --- Database (uncomment if you wire one up) ---
# POSTGRES_DB=api_db
# POSTGRES_USER=api_user
# POSTGRES_PASSWORD=api_password
# DATABASE_URL=jdbc:postgresql://postgres:5432/api_db

# --- Redis (uncomment if you swap the rate limiter store) ---
# REDIS_URL=redis://redis:6379/0
