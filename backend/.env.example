# ProdWatch Backend — Environment Variables
# --- Docker / server ---
SERVER_PORT=8080
HOST=0.0.0.0
RELOAD=false
WORKERS=1

# =============================================================================
# Docker / local server
# =============================================================================
SERVER_PORT=8080

# =============================================================================
# Google console and oauth
# =============================================================================
CLIENT_ID=
CLIENT_SECRET=
CALLBACK_URL=https://id_here.supabase.co/auth/v1/callback

# =============================================================================
# API metadata (application.properties / OpenAPI)
# =============================================================================
API_TITLE=ProdWatch API
API_VERSION=1.0.0
API_DESCRIPTION=Inventory and POS REST API for ProdWatch

# =============================================================================
# Supabase — required
# =============================================================================

# Project URL (no trailing slash)
SUPABASE_URL=https://db_id_here.supabase.co
SUPABASE_JWT_SECRET=jwt_secret_here
SUPABASE_SERVICE_ROLE_KEY=service_role_key_here
SUPABASE_ANON_KEY=anon_key_here

# =============================================================================
# PostgreSQL (Supabase) — required for Flyway + JPA
# =============================================================================

# JDBC URL — Database → Connection string → URI (Session pooler or direct)
# Use sslmode=require for Supabase hosted Postgres.
#
# Direct (migrations / dev):
#   jdbc:postgresql://db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require
# Session pooler (recommended for Render):
#   jdbc:postgresql://aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
#
# Append user/password if not embedded in URI.
# Supabase direct host user is postgres.YOUR_PROJECT_REF (not plain "postgres"):
#   jdbc:postgresql://db.YOUR_PROJECT_REF.supabase.co:5432/postgres?user=postgres.YOUR_PROJECT_REF&password=YOUR_DB_PASSWORD&sslmode=require
DATABASE_URL=jdbc:postgresql://db.your-project-ref.supabase.co:5432/postgres?user=postgres.your-project-ref&password=YOUR_DB_PASSWORD&sslmode=require

# =============================================================================
# CORS — required (comma-separated, no spaces)
# =============================================================================
# Must include every frontend origin that calls this API (local + production).
# Local: frontend dev server runs on http://localhost:8000; backend on 8080
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8000,http://localhost:8080,http://localhost:3000,https://your-app.vercel.app

# Public frontend URL (no trailing slash) — used for owner sign-up email confirmation links
# Local: http://localhost:8000   Production: https://your-app.vercel.app
FRONTEND_URL=http://localhost:8000

# =============================================================================
# Optional — Prod Watch RSA encryption (util/EnDeCrypt only)
# =============================================================================
# Generate: ./gradlew classes && java -cp build/classes/java/main com.prodwatch.api.util.KeysGenerator
# E_PUBLIC_KEY=your_public_key_pem_here
# E_PRIVATE_KEY=your_private_key_pem_here
# E_PRIVATE_PASSWORD=optional_unused_with_bundled_keygen

# =============================================================================
# Optional — Redis application cache (off by default)
# =============================================================================
# TTLs are defined in src/main/resources/core_specs/configuration/config_file.json
# (redis_cache.ttl_seconds). Full mapping: REDIS_CACHE_TTL.md in the same folder.
#
# Mode              REDIS_ENABLED   REDIS_HOST              Notes
# Off (default)     false           —                       Cache no-ops; API works normally
# Local Docker      true            localhost               docker run -p 6379:6379 redis:7-alpine
# Docker Compose    true            redis                   Service name in docker-compose.yml
# Redis Cloud       true            <endpoint>              Set REDIS_PORT, REDIS_PASSWORD, REDIS_TLS=true
#
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TLS=false

# =============================================================================
# Dev seed users — local testing only (never use in production)
# =============================================================================
# After Flyway migrations (V1–V12), provision auth users (no psql required):
#   Windows:  .\backend\scripts\seed-auth-users.ps1
#   macOS/Linux: bash backend/scripts/seed-auth-users.sh
#
# Default password for all seed accounts (override locally in backend/.env only):
# DEV_SEED_PASSWORD=ProdWatchDev2024!
#
# Seed accounts:
#   alex@acme.co   — admin (or use /signup bootstrap instead of script)
#   maya@acme.co   — warehouse_manager
#   jordan@acme.co — warehouse_worker
#   sam@acme.co    — inspector
#   riley@acme.co  — cashier
#   devon@acme.co  — cashier (inactive + banned)

# =============================================================================
# POS — optional overrides
# =============================================================================
# Bootstrap-only: seeds workspace_settings.tax_rate on first GET /api/v1/settings
# when no row exists (default 0.16 = 16%). After bootstrap, admins change tax via
# Settings UI (PATCH /api/v1/settings). Checkout reads tax from workspace_settings.
# POS_TAX_RATE=0.16
# Fixed warehouse for checkout stock deduction (UUID); omit to use each product's default warehouse
# POS_WAREHOUSE_ID=

# Logging
LOG_LEVEL=info

# --- Database (uncomment if you wire one up) ---
# POSTGRES_DB=api_db
# POSTGRES_USER=api_user
# POSTGRES_PASSWORD=api_password
# DATABASE_URL=jdbc:postgresql://postgres:5432/api_db
