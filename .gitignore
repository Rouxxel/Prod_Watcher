#############################################################################
### .gitignore for a Gradle / Spring Boot Java project
#############################################################################

# --- Build output ---
build/
out/
bin/
target/
*.class
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar
!**/gradle/wrapper/gradle-wrapper.jar

# --- Gradle ---
.gradle/
gradle-app.setting
!gradle-wrapper.properties

# --- Logs ---
logs/
log/
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal

# --- Environment / secrets ---
.env
.env.local
.env.development
.env.production
*.pem

# --- IDEs / editors ---
.idea/
*.iml
*.ipr
*.iws
.vscode/
.settings/
.project
.classpath
.factorypath
*.swp
*.swo
*~

# --- OS ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# --- Misc / local scratch ---
*.tmp
*.temp
Example.java
Tester.java

# --- Deployment scratch files ---
ecs-task-definition-final.json
trust-policy.json
apprunner-service.json

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*

----------------------
# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
.output
.vinxi
.tanstack/**
.nitro
*.local

# Wrangler / Cloudflare
.wrangler/
.dev.vars

# Editor directories and files
.vscode/*
!.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?